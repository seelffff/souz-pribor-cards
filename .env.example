# mock работает без ключа; для реальной модели поставьте openai_compat
LLM_PROVIDER=mock

# Любой OpenAI-совместимый endpoint: OpenRouter, OpenAI, DeepSeek, Ollama (http://localhost:11434/v1)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
LLM_MAX_TOKENS=8000
# json_schema (strict structured output) или json_object для моделей без поддержки схем
LLM_RESPONSE_FORMAT=json_schema
# Необязательно: low|medium|high для reasoning-моделей на OpenRouter
LLM_REASONING_EFFORT=
